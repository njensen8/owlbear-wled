import OBR from "@owlbear-rodeo/sdk";
import "./style.css";

const WLED_URL = "http://192.168.1.227/json/state";

const segments = ["Spot 1", "Spot 2", "Spot 3", "Spot 4", "Spot 5", "Vault"];

document.querySelector("#app").innerHTML = `
  <h1>Table Lights</h1>
  <p class="status">Waiting for Owlbear Rodeo...</p>

  <div class="segments">
    ${segments.map((name, index) => `
      <div class="segment">
        <h2>${name}</h2>

        <label>Color</label>
        <input type="color" value="#ffffff" data-color="${index}">

        <label>Brightness</label>
        <input type="range" min="1" max="255" value="255"
          data-brightness="${index}">

        <div class="controls">
          <button data-on="${index}">On</button>
          <button data-off="${index}">Off</button>
        </div>
      </div>
    `).join("")}
  </div>
`;

OBR.onReady(() => {
  document.querySelector(".status").textContent =
    "Connected to Owlbear Rodeo";
});

async function updateSegment(segment, settings) {
  try {
    const response = await fetch(WLED_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        seg: [{ id: segment, ...settings }]
      })
    });

    if (!response.ok) throw new Error(`WLED returned ${response.status}`);

    document.querySelector(".status").textContent =
      `${segments[segment]} updated`;
  } catch (error) {
    console.error(error);
    document.querySelector(".status").textContent =
      "WLED connection failed";
  }
}

document.querySelectorAll("[data-color]").forEach(input => {
  input.addEventListener("input", () => {
    const segment = Number(input.dataset.color);
    const hex = input.value;
    const color = [
      parseInt(hex.slice(1, 3), 16),
      parseInt(hex.slice(3, 5), 16),
      parseInt(hex.slice(5, 7), 16)
    ];

    updateSegment(segment, { col: [color] });
  });
});

document.querySelectorAll("[data-brightness]").forEach(input => {
  input.addEventListener("change", () => {
    updateSegment(Number(input.dataset.brightness), {
      bri: Number(input.value)
    });
  });
});

document.querySelectorAll("[data-on]").forEach(button => {
  button.addEventListener("click", () => {
    updateSegment(Number(button.dataset.on), { on: true });
  });
});

document.querySelectorAll("[data-off]").forEach(button => {
  button.addEventListener("click", () => {
    updateSegment(Number(button.dataset.off), { on: false });
  });
});
