import OBR from "@owlbear-rodeo/sdk";
import "./style.css";

const WLED_URL = "http://192.168.1.227/json/state";
const TRACKER_KEY = "rodeo.owlbear.initiative-tracker/metadata";
const SETTINGS_KEY = "com.owlbear.wled-table/seat-assignments";
const LIGHTING_SETTINGS_KEY = "com.owlbear.wled-table/lighting-settings";
const ORIGINAL_STATE_KEY = "com.owlbear.wled-table/original-lighting-state";

const segments = [
  "Spot 1",
  "Spot 2",
  "Spot 3",
  "Spot 4",
  "Spot 5",
  "Vault"
];

const highlightDefault = [255, 180, 0];
const vaultFlashDefault = [255, 0, 0];

let highlightColor = [...highlightDefault];
let vaultPulseColor = [...vaultFlashDefault];
let pulseDuration = 250;

let assignments = {};
let initiativeItems = [];
let highlightedSegment = null;
let savedSegmentState = null;
let activeItemId = null;
let updateQueue = Promise.resolve();

document.querySelector("#app").innerHTML = `
  <h1>Table Lights</h1>
  <p class="status">Waiting for Owlbear Rodeo...</p>

  <h2>Lighting Settings</h2>
  <div class="segment">
    <label>Turn Highlight Color</label>
    <input type="color" id="highlight-color" value="#ffb400">

    <label>Vault Transition Flash Color</label>
    <input type="color" id="vault-flash-color" value="#ff0000">

    <label>Flash Duration (milliseconds)</label>
    <input type="number" id="flash-duration"
      min="50" max="2000" step="50" value="250">
  </div>

  <h2>Character Assignments</h2>
  <p class="status">
    Each character can belong to one player seat. The Vault can be shared.
  </p>
  <div id="seat-assignments"></div>

  <h2>Manual Controls</h2>
  <div class="segments">
    ${segments.map((name, index) => `
      <div class="segment">
        <h2>${name}</h2>

        <label>Color</label>
        <input type="color" value="#ffffff" data-color="${index}">

        <label>Brightness</label>
        <input type="range" min="1" max="255" value="255"
          data-brightness="${index}">

        <div class="controls">
          <button data-on="${index}">On</button>
          <button data-off="${index}">Off</button>
        </div>
      </div>
    `).join("")}
  </div>
`;

const status = document.querySelector(".status");

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[char]);
}

function hexToRgb(hex) {
  return [
    parseInt(hex.slice(1, 3), 16),
    parseInt(hex.slice(3, 5), 16),
    parseInt(hex.slice(5, 7), 16)
  ];
}

function rgbToHex(rgb) {
  return "#" + rgb.map(value =>
    value.toString(16).padStart(2, "0")
  ).join("");
}

function loadLightingSettings(saved) {
  if (!saved || typeof saved !== "object") return;

  if (
    Array.isArray(saved.highlightColor) &&
    saved.highlightColor.length === 3
  ) {
    highlightColor = saved.highlightColor;
  }

  if (
    Array.isArray(saved.vaultPulseColor) &&
    saved.vaultPulseColor.length === 3
  ) {
    vaultPulseColor = saved.vaultPulseColor;
  }

  if (Number.isFinite(saved.pulseDuration)) {
    pulseDuration = Math.max(
      50,
      Math.min(2000, saved.pulseDuration)
    );
  }

  document.querySelector("#highlight-color").value =
    rgbToHex(highlightColor);

  document.querySelector("#vault-flash-color").value =
    rgbToHex(vaultPulseColor);

  document.querySelector("#flash-duration").value = pulseDuration;
}

function normalizeAssignments(saved) {
  const result = {};
  const assignedCharacters = new Set();

  for (let i = 0; i < segments.length; i++) {
    const value = saved?.[i];
    const ids = Array.isArray(value)
      ? value
      : typeof value === "string" && value
        ? [value]
        : [];

    if (i < seatCount) {
      // Each player seat can have only one character, and a character
      // can belong to only one segment (including the shared Vault).
      const firstValid = ids.find(id =>
        typeof id === "string" && !assignedCharacters.has(id)
      );
      result[i] = firstValid ? [firstValid] : [];
      if (firstValid) assignedCharacters.add(firstValid);
    } else {
      // Vault can hold multiple characters, but cannot duplicate a player seat.
      result[i] = ids.filter(id => {
        if (typeof id !== "string" || assignedCharacters.has(id)) {
          return false;
        }
        assignedCharacters.add(id);
        return true;
      });
    }
  }

  return result;
}

function renderAssignments() {
  const container = document.querySelector("#seat-assignments");

  container.innerHTML = segments.map((name, index) => {
    const selectedHere = assignments[index] || [];
    const seatIsFilled = index < seatCount && selectedHere.length > 0;

    const visibleItems = initiativeItems.filter(item => {
      const alreadyAssignedElsewhere = segments.some((_, otherIndex) =>
        otherIndex !== index &&
        (assignments[otherIndex]?.includes(item.id) ?? false)
      );

      if (alreadyAssignedElsewhere) return false;

      // A player seat shows only its current character once filled.
      // Unchecking that character makes the other options reappear.
      if (index < seatCount && seatIsFilled) {
        return selectedHere.includes(item.id);
      }

      // An empty player seat shows only unassigned characters.
      // Vault can select multiple characters, but excludes all characters
      // already assigned to one of the five player seats.
      return true;
    });

    return `
      <div class="segment">
        <h2>${name}</h2>
        ${
          initiativeItems.length
            ? visibleItems.length
              ? visibleItems.map(item => `
                  <label class="character-option">
                    <input
                      type="checkbox"
                      data-segment="${index}"
                      data-character="${escapeHTML(item.id)}"
                      ${selectedHere.includes(item.id) ? "checked" : ""}
                    >
                    ${escapeHTML(item.name)}
                  </label>
                `).join("")
              : `<p class="status">${seatIsFilled ? "Uncheck the selected character to choose another." : "No available characters."}</p>`
            : '<p class="status">No initiative characters found.</p>'
        }
      </div>
    `;
  }).join("");

  container.querySelectorAll("[data-segment]").forEach(input => {
    input.addEventListener("change", async () => {
      const segment = Number(input.dataset.segment);
      const character = input.dataset.character;

      if (!assignments[segment]) assignments[segment] = [];

      if (input.checked) {
        // Remove this character from every other segment first.
        // Player seats remain single-character; Vault may contain many.
        for (let i = 0; i < segments.length; i++) {
          if (i !== segment) {
            assignments[i] = (assignments[i] || [])
              .filter(id => id !== character);
          }
        }

        if (segment < seatCount) {
          // A player seat holds exactly one character.
          assignments[segment] = [character];
        } else if (!assignments[segment].includes(character)) {
          assignments[segment].push(character);
        }
      } else {
        assignments[segment] = assignments[segment]
          .filter(id => id !== character);
      }

      try {
        await OBR.room.setMetadata({
          [SETTINGS_KEY]: assignments
        });

        renderAssignments();
        status.textContent = "Character assignments saved";
        queueTurnUpdate();
      } catch (error) {
        console.error(error);
        status.textContent = "Could not save assignments";
      }
    });
  });
}

function getTrackerMetadata(item) {
  const metadata = item.metadata?.[TRACKER_KEY];

  if (
    metadata &&
    typeof metadata.count === "string" &&
    typeof metadata.active === "boolean"
  ) {
    return metadata;
  }

  return null;
}

function getSegmentSettings(segment) {
  const keys = [
    "on", "bri", "cct", "col", "fx", "sx", "ix",
    "pal", "c1", "c2", "c3", "rev", "mi",
    "o1", "o2", "o3", "frz"
  ];

  const settings = {};

  for (const key of keys) {
    if (segment[key] !== undefined) {
      settings[key] = segment[key];
    }
  }

  return settings;
}

async function postSegment(segment, settings) {
  const response = await fetch(WLED_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      seg: [{ id: segment, ...settings }]
    })
  });

  if (!response.ok) {
    throw new Error(`WLED returned ${response.status}`);
  }
}

async function persistOriginalState() {
  if (highlightedSegment === null || !savedSegmentState) {
    return;
  }

  await OBR.room.setMetadata({
    [ORIGINAL_STATE_KEY]: {
      segment: highlightedSegment,
      settings: savedSegmentState,
      activeItemId
    }
  });
}

async function clearPersistedOriginalState() {
  await OBR.room.setMetadata({
    [ORIGINAL_STATE_KEY]: null
  });
}

async function restoreHighlight() {
  if (highlightedSegment === null || !savedSegmentState) {
    return;
  }

  const segment = highlightedSegment;
  const original = savedSegmentState;

  // Restore the actual lights before clearing the saved backup.
  await postSegment(segment, original);
  await clearPersistedOriginalState();

  highlightedSegment = null;
  savedSegmentState = null;
  activeItemId = null;
}

async function recoverOriginalState(saved) {
  if (
    !saved ||
    typeof saved !== "object" ||
    !Number.isInteger(saved.segment) ||
    saved.segment < 0 ||
    saved.segment >= segments.length ||
    !saved.settings ||
    typeof saved.settings !== "object"
  ) {
    return;
  }

  status.textContent = "Recovering previous lighting...";

  await postSegment(saved.segment, saved.settings);
  await clearPersistedOriginalState();

  status.textContent = "Previous lighting restored";
}

async function startVaultPulse() {
  await postSegment(5, {
    on: true,
    fx: 0,
    col: [vaultPulseColor, [0, 0, 0], [0, 0, 0]]
  });

  await new Promise(resolve => setTimeout(resolve, pulseDuration));

  await postSegment(5, {
    on: true,
    fx: 0,
    col: [highlightColor, [0, 0, 0], [0, 0, 0]]
  });
}

function getVaultRunLength(items, activeItem) {
  const ordered = [...items].sort((a, b) => {
    return Number(b.count) - Number(a.count);
  });

  const activeIndex = ordered.findIndex(
    item => item.id === activeItem.id
  );

  if (activeIndex === -1) return 0;

  function belongsToVault(item) {
    return assignments[5]?.includes(item.id) ?? false;
  }

  if (!belongsToVault(activeItem)) return 0;

  let previousVaultCharacters = 0;

  for (let i = activeIndex - 1; i >= 0; i--) {
    if (!belongsToVault(ordered[i])) break;
    previousVaultCharacters++;
  }

  return previousVaultCharacters + 1;
}

async function applyActiveTurn() {
  const activeItem = initiativeItems.find(item => item.active);

  let desiredSegment = null;

  if (activeItem) {
    for (let i = 0; i < segments.length; i++) {
      if (assignments[i]?.includes(activeItem.id)) {
        desiredSegment = i;
        break;
      }
    }
  }

  if (desiredSegment === null) {
    await restoreHighlight();
    activeItemId = null;
    status.textContent = "No assigned character is active";
    return;
  }

  const vaultRunLength = desiredSegment === 5
    ? getVaultRunLength(initiativeItems, activeItem)
    : 0;

  const shouldFlash = desiredSegment === 5 && vaultRunLength >= 2;

  if (desiredSegment === highlightedSegment) {
    const characterChanged = activeItemId !== activeItem.id;
    activeItemId = activeItem.id;

    if (desiredSegment === 5 && shouldFlash && characterChanged) {
      await startVaultPulse();
    }

    status.textContent =
      `${activeItem.name}'s turn — ${segments[desiredSegment]}`;
    return;
  }

  await restoreHighlight();

  const response = await fetch(WLED_URL);

  if (!response.ok) {
    throw new Error(`WLED returned ${response.status}`);
  }

  const state = await response.json();
  const segment = state.seg.find(s => s.id === desiredSegment);

  if (!segment) {
    throw new Error(`WLED segment ${desiredSegment} not found`);
  }

  savedSegmentState = getSegmentSettings(segment);
  highlightedSegment = desiredSegment;
  activeItemId = activeItem.id;

  // Save the original state in Owlbear before changing the lights.
  await persistOriginalState();

  if (shouldFlash) {
    await startVaultPulse();
  } else {
    await postSegment(desiredSegment, {
      on: true,
      fx: 0,
      col: [highlightColor, [0, 0, 0], [0, 0, 0]]
    });
  }

  status.textContent =
    `${activeItem.name}'s turn — ${segments[desiredSegment]}`;
}

function queueTurnUpdate() {
  updateQueue = updateQueue
    .then(() => applyActiveTurn())
    .catch(error => {
      console.error(error);
      status.textContent = "Lighting update failed — check connection";
    });
}

function handleItemsChange(items) {
  initiativeItems = items
    .map(item => {
      const metadata = getTrackerMetadata(item);

      if (!metadata) return null;

      return {
        id: item.id,
        name: item.text?.plainText || item.name || "Unnamed",
        count: metadata.count,
        active: metadata.active
      };
    })
    .filter(Boolean);

  renderAssignments();
  queueTurnUpdate();
}

async function updateSegment(segment, settings) {
  try {
    if (highlightedSegment === segment && savedSegmentState) {
      // Preserve manual changes as the new original state.
      Object.assign(savedSegmentState, settings);
      await persistOriginalState();

      status.textContent =
        `${segments[segment]} settings saved for after the turn`;
      return;
    }

    await postSegment(segment, settings);
    status.textContent = `${segments[segment]} updated`;
  } catch (error) {
    console.error(error);
    status.textContent = "WLED connection failed";
  }
}

async function saveLightingSettings() {
  const settings = {
    highlightColor,
    vaultPulseColor,
    pulseDuration
  };

  try {
    await OBR.room.setMetadata({
      [LIGHTING_SETTINGS_KEY]: settings
    });

    status.textContent = "Lighting settings saved";
  } catch (error) {
    console.error(error);
    status.textContent = "Could not save lighting settings";
  }
}

document.querySelector("#highlight-color").addEventListener("input", async event => {
  highlightColor = hexToRgb(event.target.value);
  await saveLightingSettings();
});

document.querySelector("#vault-flash-color").addEventListener("input", async event => {
  vaultPulseColor = hexToRgb(event.target.value);
  await saveLightingSettings();
});

document.querySelector("#flash-duration").addEventListener("change", async event => {
  pulseDuration = Math.max(
    50,
    Math.min(2000, Number(event.target.value) || 250)
  );

  event.target.value = pulseDuration;
  await saveLightingSettings();
});

document.querySelectorAll("[data-color]").forEach(input => {
  input.addEventListener("input", () => {
    const segment = Number(input.dataset.color);
    const hex = input.value;

    const color = [
      parseInt(hex.slice(1, 3), 16),
      parseInt(hex.slice(3, 5), 16),
      parseInt(hex.slice(5, 7), 16)
    ];

    updateSegment(segment, { col: [color] });
  });
});

document.querySelectorAll("[data-brightness]").forEach(input => {
  input.addEventListener("change", () => {
    updateSegment(Number(input.dataset.brightness), {
      bri: Number(input.value)
    });
  });
});

document.querySelectorAll("[data-on]").forEach(button => {
  button.addEventListener("click", () => {
    updateSegment(Number(button.dataset.on), { on: true });
  });
});

document.querySelectorAll("[data-off]").forEach(button => {
  button.addEventListener("click", () => {
    updateSegment(Number(button.dataset.off), { on: false });
  });
});

OBR.onReady(async () => {
  status.textContent = "Connected to Owlbear Rodeo";

  try {
    const roomMetadata = await OBR.room.getMetadata();

    assignments = normalizeAssignments(roomMetadata[SETTINGS_KEY]);
    loadLightingSettings(roomMetadata[LIGHTING_SETTINGS_KEY]);

    // Recover any segment state saved before a previous reload.
    await recoverOriginalState(roomMetadata[ORIGINAL_STATE_KEY]);

    OBR.room.onMetadataChange(metadata => {
      assignments = normalizeAssignments(metadata[SETTINGS_KEY]);
      loadLightingSettings(metadata[LIGHTING_SETTINGS_KEY]);
      renderAssignments();
    });

    OBR.scene.items.onChange(handleItemsChange);

    const items = await OBR.scene.items.getItems();
    handleItemsChange(items);

  } catch (error) {
    console.error(error);
    status.textContent =
      "Connected, but could not load or restore lighting settings";
  }
});
